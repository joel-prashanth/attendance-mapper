{
  "manifest_version": 3,
  "name": "Attendance Mapper BETA",
  "version": "0.5.0",
  "description": "Preview and safely submit faculty attendance from authorized Google Sheets to Aurora ERP.",

  "permissions": ["storage"],

  "host_permissions": [
    "https://admissionsserver.aurora.edu.in/*",
    "https://docs.google.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Attendance Mapper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
